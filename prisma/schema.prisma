generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id       Int       @id @default(autoincrement())
  user     String    @unique
  password String
  email    String    @unique
  goals    Goal[]
  Routine  Routine[]
}

model RoutineExercise {
  id          Int     @id @default(autoincrement())
  name        String
  weight      String
  series      Int
  repetitions String
  routineId   Int
  order       Int     @default(0)
  exerciseId  Int?
  Routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise    Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
}

model Routine {
  id              Int               @id @default(autoincrement())
  name            String
  personId        Int
  duration        Int?
  person          Person            @relation(fields: [personId], references: [id])
  routineExercise RoutineExercise[]
}

// Catalogo de ejercicios importado de workout-guide (CC BY-SA 4.0).
// El slug es la clave del dataset y con el se arman las URLs de los 3 frames.
model Exercise {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  name             String
  exerciseType     String
  equipment        String
  primaryMuscle    String
  secondaryMuscles String[]
  isStretch        Boolean  @default(false)
  frameCount       Int      @default(3)

  routineExercises RoutineExercise[]

  @@index([primaryMuscle])
  @@index([equipment])
}

model Goal {
  id        Int         @id @default(autoincrement())
  weight    String
  date      DateTime    @default(now())
  personId  Int
  objective String
  person    Person      @relation(fields: [personId], references: [id])
  images    GoalImage[]
}

model GoalImage {
  id     Int    @id @default(autoincrement())
  url    String
  goalId Int?
  goal   Goal?  @relation(fields: [goalId], references: [id])
}
